# Copy these values to apps/web/.env.local for the public portfolio.
# Project ID and dataset identify public content; they are not credentials.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required only for draft previews; never prefix these with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Copy these public identifiers to apps/studio/.env for Sanity Studio.
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production
